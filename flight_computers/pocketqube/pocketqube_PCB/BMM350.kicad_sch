				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "a3dfa7d0-33ce-4224-bac4-f28acd17ed66")
	)
	(text_box "Also, stay consistent. VCC or VDD for everything, not both.\n- Joel\n"
